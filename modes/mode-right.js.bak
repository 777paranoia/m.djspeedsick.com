GLSL.modules['room_right'] = `
precision mediump float;
uniform vec2 u_resolution;
uniform vec2 u_mouse;
uniform sampler2D u_texEnv1; // right-mobile.png
uniform sampler2D u_texEnv2; // Video 0 — Tall Left        (TEXTURE9)
uniform sampler2D u_texEnv3; // Video 1 — Top Center       (TEXTURE10)
uniform sampler2D u_texEnv4; // Video 2 — Bottom Center    (TEXTURE11)
uniform sampler2D u_texEnv6; // Video 3 — Small Bottom-L   (TEXTURE12)
uniform sampler2D u_texEnv5; // Mirror  — mode shader      (TEXTURE13)

void main() {
    vec2 uv = gl_FragCoord.xy / u_resolution;
    uv.y = 1.0 - uv.y;
    float panRangeX = 300.0 / 1243.0;
    float panRangeY = 300.0 / 2000.0;
    float screenAspect = u_resolution.x / u_resolution.y;
    float visibleAspect = 643.0 / 2000.0;
    vec2 tuv;
    if (screenAspect > visibleAspect) {
        float scale = visibleAspect / screenAspect;
        tuv = vec2(uv.x, (uv.y - 0.5) * scale + 0.5);
    } else {
        float scale = screenAspect / visibleAspect;
        tuv = vec2((uv.x - 0.5) * scale + 0.5, uv.y);
    }
    tuv.x = tuv.x * (1.0 - 2.0 * panRangeX) + panRangeX - u_mouse.x * panRangeX;
    tuv.y = tuv.y * (1.0 - 2.0 * panRangeY) + panRangeY - u_mouse.y * panRangeY;

    vec4 room = texture2D(u_texEnv1, tuv);
    bool isGreen = room.g > 0.4 && room.r < 0.25 && room.b < 0.25;

    if (isGreen) {
        float px = tuv.x * 1243.0;
        float py = tuv.y * 2000.0;
        vec2 bMin, bMax;

        // Tall Left (Region 2)
        if (px >= 162.0 && px <= 292.0 && py >= 882.0 && py <= 1109.0) {
            bMin = vec2(162.0/1243.0, 882.0/2000.0);
            bMax = vec2(292.0/1243.0, 1109.0/2000.0);
            gl_FragColor = texture2D(u_texEnv2, (tuv - bMin) / (bMax - bMin));
            return;
        }
        // Top Center (Region 3)
        if (px >= 472.0 && px <= 648.0 && py >= 885.0 && py <= 968.0) {
            bMin = vec2(472.0/1243.0, 885.0/2000.0);
            bMax = vec2(648.0/1243.0, 968.0/2000.0);
            gl_FragColor = texture2D(u_texEnv3, (tuv - bMin) / (bMax - bMin));
            return;
        }
        // Bottom Center (Region 8)
        if (px >= 494.0 && px <= 659.0 && py >= 1003.0 && py <= 1085.0) {
            bMin = vec2(494.0/1243.0, 1003.0/2000.0);
            bMax = vec2(659.0/1243.0, 1085.0/2000.0);
            gl_FragColor = texture2D(u_texEnv4, (tuv - bMin) / (bMax - bMin));
            return;
        }
        // Small Bottom-Left (Region 9)
        if (px >= 364.0 && px <= 433.0 && py >= 1021.0 && py <= 1111.0) {
            bMin = vec2(364.0/1243.0, 1021.0/2000.0);
            bMax = vec2(433.0/1243.0, 1111.0/2000.0);
            gl_FragColor = texture2D(u_texEnv6, (tuv - bMin) / (bMax - bMin));
            return;
        }
        // Mirror (Region 5)
        if (px >= 790.0 && px <= 1002.0 && py >= 945.0 && py <= 1046.0) {
            bMin = vec2(790.0/1243.0, 945.0/2000.0);
            bMax = vec2(1002.0/1243.0, 1046.0/2000.0);
            vec4 mirrorCol = texture2D(u_texEnv5, (tuv - bMin) / (bMax - bMin));
            gl_FragColor = vec4(mirrorCol.rgb * 3.0, 1.0);
            return;
        }
        gl_FragColor = room;
    } else {
        gl_FragColor = room;
    }
}
`;
